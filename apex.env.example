# Comma-separated list of "platform:accountName" pairs.
# platform is one of: origin (PC - use this for Steam too, since Apex PC
# accounts are EA/Origin accounts regardless of storefront), psn (PlayStation),
# xbl (Xbox).
# accountName must be your EA/Origin display name (shown in the Apex Legends
# main menu / EA app), which may differ from your Steam username.
ACCOUNTS=origin:YourEADisplayName,psn:AnotherAccount

# Get a free key at https://tracker.gg/developers
TRACKER_API_KEY=

# How often the poller service checks for new matches/rank.
POLL_INTERVAL_MINUTES=15

# Postgres credentials used by the db service and app/poller DATABASE_URL.
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apex_tracker
